rules_version = '2';

// PokéCraft Idle 2 — Regras de Segurança do Firestore
// Atualizado em: v2.11.3 — validação de campos, tamanho e integridade
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ──────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isOwnerSlot(docId) {
      return isAuth() && (
        docId == request.auth.uid ||
        docId == request.auth.uid + '_s2' ||
        docId == request.auth.uid + '_s3'
      );
    }

    // Valida que o payload de save/snapshot tem os campos mínimos esperados.
    function isValidSavePayload(uid) {
      let data = request.resource.data;
      return
        // Campos obrigatórios presentes: save usa updatedAt, snapshot usa createdAt
        data.keys().hasAll(['compressedState']) &&
        (data.keys().hasAny(['updatedAt']) || data.keys().hasAny(['createdAt'])) &&
        // compressedState é string e não está vazio
        data.compressedState is string &&
        data.compressedState.size() > 0 &&
        // Tamanho máximo do estado comprimido: ~950 KB
        // (Firestore permite 1MB por documento; deixamos margem para metadados)
        data.compressedState.size() <= 950000;
    }

    // Valida payload de dano ao Boss para o ranking
    function isValidBossDamage() {
      let data = request.resource.data;
      return
        data.keys().hasAll(['damage', 'uid']) &&
        data.damage is number &&
        data.damage >= 0 &&
        // Teto anti-cheat: dano impossível de atingir legitimamente em 60s
        data.damage <= 99_999_999 &&
        data.uid == request.auth.uid;
    }

    // ─── config do app ────────────────────────────────────────────
    // Leitura pública (checagem de versão na tela de login).
    // Escrita bloqueada para todos — só via Firebase Console / Admin SDK.
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // ─── saves do jogador ─────────────────────────────────────────
    // Apenas o próprio jogador lê e escreve o seu save.
    // Escrita validada: campos obrigatórios + tamanho + uid consistente.
    match /saves/{uid} {
      allow read: if isOwnerSlot(uid);
      allow create, update: if isOwnerSlot(uid) && isValidSavePayload(uid);
      allow delete: if isOwnerSlot(uid);
    }

    // Snapshots diários: mesmo owner, tamanho máximo idêntico.
    match /saves/{uid}/snapshots/{day} {
      allow read: if isOwnerSlot(uid);
      allow create, update: if isOwnerSlot(uid) && isValidSavePayload(uid);
      allow delete: if isOwnerSlot(uid);
    }

    // ─── perfis públicos ──────────────────────────────────────────
    // Qualquer autenticado lê; apenas o dono escreve.
    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isOwnerSlot(uid);
      allow delete: if isOwnerSlot(uid);
    }

    // ─── multi-avatar ─────────────────────────────────────────────
    match /avatarMeta/{uid} {
      allow read, write, delete: if isOwner(uid);
    }

    match /nicknames/{nick} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── regiões publicadas ───────────────────────────────────────
    match /userRegions/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ─── rankings do Boss ─────────────────────────────────────────
    // Leitura pública para o ranking; escrita validada (anti-cheat de dano).
    match /bossRankings/{uid} {
      allow read: if isAuth();
      allow create, update: if isOwner(uid) && isValidBossDamage();
      allow delete: if isOwner(uid);
    }

    // ─── sistema de amigos ────────────────────────────────────────
    // Solicitações: destinatário lê/deleta; remetente cria (apenas por si mesmo).
    match /friends/{uid}/requests/{fromUid} {
      allow read, delete: if isOwner(uid);
      allow create: if isAuth() && request.auth.uid == fromUid;
      allow update: if false;
    }

    // Lista de amigos: dono gerencia a propria lista; aceitar pedido permite
    // criar o espelho na lista do remetente enquanto a request existir.
    match /friends/{uid}/list/{friendUid} {
      allow read, write: if isOwner(uid);
      allow create: if isOwner(uid) || (
        isAuth() &&
        request.auth.uid == friendUid &&
        exists(/databases/$(database)/documents/friends/$(friendUid)/requests/$(uid))
      );
      allow delete: if isOwner(uid) || request.auth.uid == friendUid;
    }

    // ─── fallback ─────────────────────────────────────────────────
    // Tudo que não foi explicitamente liberado acima é bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
