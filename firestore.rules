rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Saves: apenas o próprio jogador lê e escreve ──────────────────────────
    match /saves/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Perfis públicos: qualquer autenticado lê, só o dono escreve ───────────
    match /users/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Regiões publicadas: qualquer autenticado lê, só o dono escreve ────────
    match /userRegions/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Rankings do Boss: qualquer autenticado lê, só o dono escreve ──────────
    match /bossRankings/{uid} {
      allow read: if isAuth();
      allow write: if isOwner(uid);
    }

    // ── Sistema de Amigos ──────────────────────────────────────────────────────

    // Solicitações: destinatário lê/deleta; remetente cria (apenas para si)
    match /friends/{uid}/requests/{fromUid} {
      allow read, delete: if isOwner(uid);
      allow create: if isAuth() && request.auth.uid == fromUid;
      allow update: if false;
    }

    // Lista de amigos: só o dono lê e escreve
    match /friends/{uid}/list/{friendUid} {
      allow read, write: if isOwner(uid);
    }
  }
}
